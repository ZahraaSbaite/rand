# Dependencies
/vendor/
node_modules/

# Environment variables (secrets!)
.env
.env.backup
.env.production
frontend/.env

# Laravel generated files (uploads, caches, logs live under storage/ and are
# ignored by the .gitignore files there)
/public/hot
/public/storage
/storage/*.key

# Build output
dist/
build/
frontend/dist/

# Vercel CLI
.vercel/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
