{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{frontend/**,storage/app/uploads/**,.impeccable/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.php" },
    { "source": "/uploads/(.*)", "destination": "/api/index.php" },
    { "source": "/health", "destination": "/api/index.php" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
