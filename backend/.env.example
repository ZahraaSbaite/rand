PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/crochet_shop
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Absolute path to store uploaded images. In production, point this at a
# mounted persistent disk (e.g. Render disk mount path) so uploads survive
# deploys/restarts. Leave unset to use the local ./uploads folder.
UPLOADS_DIR=

# bcrypt hash of the admin password (generate with: node -e "console.log(require('bcrypt').hashSync('yourpassword', 12))")
ADMIN_PASSWORD_HASH=
# long random string used to sign admin session JWTs (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
