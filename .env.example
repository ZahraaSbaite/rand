APP_NAME=Strand
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:4000

# Laravel's encryption key. Generate with: php artisan key:generate --show
APP_KEY=

LOG_CHANNEL=stderr
CACHE_STORE=database

# Postgres connection string. On Vercel the Supabase integration sets POSTGRES_URL.
DB_URL=postgresql://postgres:password@127.0.0.1:5432/crochet_shop

# Where the React dev server runs (only needed for cross-origin requests).
FRONTEND_URL=http://localhost:5173

# bcrypt hash of the admin password. Generate with:
#   php -r "echo password_hash('yourpassword', PASSWORD_BCRYPT), PHP_EOL;"
ADMIN_PASSWORD_HASH=

# Long random string used to sign admin sessions. Generate with:
#   php -r "echo bin2hex(random_bytes(48)), PHP_EOL;"
JWT_SECRET=

# Set by Vercel when a Blob store is connected. Leave empty locally to save
# uploads under storage/app/uploads.
BLOB_READ_WRITE_TOKEN=
